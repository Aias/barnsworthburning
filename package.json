{
	"name": "barnsworthburning",
	"version": "6.0.0",
	"license": "MIT",
	"author": {
		"name": "Nick Trombley",
		"email": "trombley.nick@gmail.com",
		"url": "https://nicktrombley.design"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Aias/barnsworthburning"
	},
	"type": "module",
	"imports": {
		"#components/*": "./src/components/*",
		"#helpers/*": "./src/helpers/*",
		"#lib/*": "./src/lib/*",
		"#styles/*": "./src/styles/*",
		"#types/*": "./src/types/*"
	},
	"scripts": {
		"build": "bunx --bun vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"dev": "bunx --bun vite dev",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxfmt --check && oxlint --fix --type-aware .",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "bunx --bun vite preview"
	},
	"dependencies": {
		"@aias/hozo": "~0.13.0",
		"drizzle-orm": "1.0.0-rc.5",
		"marked": "~18.1.2",
		"normalize.css": "~8.0.1",
		"postgres": "~3.4.9",
		"xml-formatter": "~3.7.0",
		"zod": "~4.6.7"
	},
	"devDependencies": {
		"@lucide/svelte": "~1.64.0",
		"@radix-ui/colors": "~3.0.0",
		"@sveltejs/adapter-bun": "~1.0.0",
		"@sveltejs/kit": "~3.1.0",
		"@sveltejs/vite-plugin-svelte": "~7.3.1",
		"@types/node": "~26.6.6",
		"@typescript/native": "npm:typescript@~7.0.2",
		"oxfmt": "~0.75.0",
		"oxlint": "~1.90.0",
		"oxlint-tsgolint": "~7.0.2005",
		"svelte": "~5.57.3",
		"svelte-check": "~4.7.7",
		"tslib": "~2.8.1",
		"typescript": "~6.0.3",
		"vite": "~8.3.5"
	}
}
